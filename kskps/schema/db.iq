Schema [
    {time 3H 3V 4H 4V}: State -> F64
]

Instance [
    $states {normal abnormal1 abnormal2 abnormal3 abnormal4}
    %states: 1 -> State
    $sample 'sample.csv'

    {%sample#0}: 1 -> F64
    %states.time = {Hom 1 -> F64(%sample#0)}

    $sensors {3H 3V 4H 4V}
    %states.%sensors = {Hom 1 -> F64(%sample#{{1~4} {5~8} {9~12} {13~16} {17~20}})}

    1.a.F = 1.aa
    1.b.F = 1.bb
    1.a.b.F = 1.aa.bb
]
aaa